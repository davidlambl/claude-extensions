{
  "description": "Asks before every read.py query or check, with the plan it would run as the reason",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.py"], "if": "Bash(*read.py*)", "timeout": 10, "onFailure": "block" },
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.py"], "if": "Bash(*m read *)", "timeout": 10, "onFailure": "block" },
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.py"], "if": "Bash(*mread *)", "timeout": 10, "onFailure": "block" },
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.py"], "if": "PowerShell(*read.py*)", "timeout": 10, "onFailure": "block" },
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.py"], "if": "PowerShell(*m read *)", "timeout": 10, "onFailure": "block" },
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.py"], "if": "PowerShell(*mread *)", "timeout": 10, "onFailure": "block" }
        ]
      }
    ]
  }
}
